{
  "name": "bb-plugin-ivar",
  "version": "0.1.0",
  "keywords": [
    "bb-plugin"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "npx -y -p bb-app@0.43.1 bb plugin build"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.4.87",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pierre/diffs": "1.4.2",
    "@radix-ui/react-select": "^2.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "react": "^19.3.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.87"
  },
  "packageManager": "pnpm@10.33.4",
  "bb": {
    "name": "ivar",
    "description": "Manage an ivar hall and review features locally.",
    "branding": {
      "icon": "Network"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  }
}
